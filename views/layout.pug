doctype html
html
  head
    title= title
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    header.site-header
      div.container
        a.brand(href='/')
          div.brand-mark DD
          div.brand-text
            span.brand-overline Downtown
            span.brand-name Donuts
        nav.nav
          a(href='/') Home
          a(href='/menu') Menu
          a(href='/about') About
          a(href='/comments') Comments
        a.order-link(href='https://www.doordash.com', target='_blank') Order now
    block content
    footer.site-footer
      div.container
        div.footer-brand
          div.brand-mark.small DD
          div
            p.footer-title Downtown Donuts
            p.footer-note Cozy donuts and coffee since 1992.
        div.footer-links
          a(href='/menu') Menu
          a(href='/about') About
          a(href='/comments') Community wall
