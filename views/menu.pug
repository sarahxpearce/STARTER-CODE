extends layout

block content
  main.container
    section.page-head
      p.kicker Menu
      h1 Downtown Donuts favorites
      p.lede Fresh glazes, seasonal fillings, and coffee that keeps pace with busy mornings.
    section.menu-grid
      each section in menuSections
        div.menu-card
          h3= section.title
          ul
            each entry in section.items
              li
                span.menu-name= entry.name
                span.menu-detail= entry.detail
    section.callout
      h3 Order for pickup or delivery
      p Use the links below to start an order.
      div.actions
        each link in orderingLinks
          a.button.primary(href=link.href, target='_blank')= link.label
