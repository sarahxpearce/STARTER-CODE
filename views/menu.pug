extends layout

block content
  main.container
    section.page-head
      p.kicker Menu
      h1 Downtown Donuts menu
      p.lede Lorem ipsum lorem ipsum lorem ipsum.
    section.menu-grid
      each section in menuSections
        div.menu-card
          h3= section.title
          ul
            each entry in section.items
              li
                span.menu-name= entry.name
                span.menu-detail= entry.detail
    section.callout
      h3 Order ahead
      p Lorem ipsum lorem ipsum lorem ipsum.
      div.actions
        each link in orderingLinks
          a.button.primary(href=link.href, target='_blank')= link.label
