extends layout

block content
  main.container
    section.page-head
      p.kicker Menu
      h1 Lorem ipsum dolor sit amet
      p.lede Lorem ipsum dolor sit amet, consectetur adipiscing elit.
    section.menu-grid
      each section in menuSections
        div.menu-card
          h3= section.title
          ul
            each entry in section.items
              li
                span.menu-name= entry.name
                span.menu-detail= entry.detail
    section.callout
      h3 Lorem ipsum dolor sit amet
      p Lorem ipsum dolor sit amet, consectetur adipiscing elit.
      div.actions
        each link in orderingLinks
          a.button.primary(href=link.href, target='_blank')= link.label
